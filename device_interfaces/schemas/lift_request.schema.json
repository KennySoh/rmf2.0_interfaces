{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lift_request",
  "title": "LiftRequest",
  "description": "Lift dispatch request published by the FCS on the device request topic (§7.2.6, Open-RMF aligned).",
  "type": "object",
  "required": ["request_time", "session_id", "lift_name", "request_type", "destination_floor", "door_state"],
  "properties": {
    "request_time": { "$ref": "#/$defs/TimeValue" },
    "session_id": {
      "type": "string"
    },
    "lift_name": {
      "type": "string"
    },
    "request_type": {
      "type": "integer",
      "enum": [0, 1, 2],
      "description": "0=END_SESSION 1=AGV_MODE 2=HUMAN_MODE"
    },
    "destination_floor": {
      "type": "string"
    },
    "door_state": {
      "type": "integer",
      "enum": [0, 1, 2],
      "description": "Requested door state at destination: 0=CLOSED 1=MOVING 2=OPEN"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "TimeValue": {
      "type": "object",
      "required": ["sec", "nanosec"],
      "properties": {
        "sec": { "type": "integer" },
        "nanosec": { "type": "integer", "minimum": 0, "maximum": 999999999 }
      },
      "additionalProperties": false
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lift_state",
  "title": "LiftState",
  "description": "Lift operational state published on the device state topic (§7.2.5, Open-RMF aligned).",
  "type": "object",
  "required": ["lift_time", "lift_name", "current_floor", "destination_floor", "door_state", "motion_state", "current_mode"],
  "properties": {
    "lift_time": { "$ref": "#/$defs/TimeValue" },
    "lift_name": {
      "type": "string"
    },
    "available_floors": {
      "type": "array",
      "items": { "type": "string" }
    },
    "current_floor": {
      "type": "string"
    },
    "destination_floor": {
      "type": "string"
    },
    "door_state": {
      "type": "integer",
      "enum": [0, 1, 2],
      "description": "0=CLOSED 1=MOVING 2=OPEN"
    },
    "motion_state": {
      "type": "integer",
      "enum": [0, 1, 2, 3],
      "description": "0=STOPPED 1=UP 2=DOWN 3=UNKNOWN"
    },
    "current_mode": {
      "type": "integer",
      "enum": [1, 2, 4],
      "description": "1=HUMAN 2=AGV 4=OFFLINE"
    },
    "session_id": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "TimeValue": {
      "type": "object",
      "required": ["sec", "nanosec"],
      "properties": {
        "sec": { "type": "integer" },
        "nanosec": { "type": "integer", "minimum": 0, "maximum": 999999999 }
      },
      "additionalProperties": false
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "vda5050_mobile_robot_order",
  "title": "VDA5050MobileRobotOrder",
  "description": "Order sent by the FCS to the VDA5050 controller on the order topic. The controller compiles this into a native VDA5050 Order and dispatches it to the AGV via the assign_order ROS 2 service.",
  "type": "object",
  "required": ["orderId", "orderUpdateId", "nodes"],
  "properties": {
    "timestamp": { "type": "string", "format": "date-time" },
    "orderId": { "type": "string" },
    "orderUpdateId": {
      "type": "integer",
      "minimum": 0,
      "description": "Increment on every update to the same orderId"
    },
    "version": {
      "type": "string",
      "description": "VDA5050 protocol version, e.g. \"2.0.0\""
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "description": "Waypoint sequence. Even sequenceIds (0, 2, 4, …).",
      "items": { "$ref": "#/$defs/Node" }
    },
    "edges": {
      "type": "array",
      "description": "Traversal links between nodes. Odd sequenceIds (1, 3, 5, …). Omit to auto-generate.",
      "items": { "$ref": "#/$defs/Edge" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "NodePosition": {
      "type": "object",
      "required": ["x", "y", "mapId"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "mapId": { "type": "string" }
      },
      "additionalProperties": false
    },
    "ActionParameter": {
      "type": "object",
      "required": ["key", "value"],
      "properties": {
        "key": { "type": "string" },
        "value": { "type": "string" }
      },
      "additionalProperties": false
    },
    "Action": {
      "type": "object",
      "required": ["actionType", "actionId", "blockingType"],
      "properties": {
        "actionType": { "type": "string" },
        "actionId": { "type": "string" },
        "blockingType": { "type": "string", "enum": ["NONE", "SOFT", "HARD"] },
        "actionDescription": { "type": "string" },
        "actionParameters": {
          "type": "array",
          "items": { "$ref": "#/$defs/ActionParameter" }
        }
      },
      "additionalProperties": false
    },
    "Node": {
      "type": "object",
      "required": ["nodeId", "sequenceId", "released"],
      "properties": {
        "nodeId": { "type": "string" },
        "sequenceId": {
          "type": "integer",
          "minimum": 0,
          "description": "Even integers (0, 2, 4, …)"
        },
        "released": {
          "type": "boolean",
          "description": "true = base (AGV may drive to it); false = horizon"
        },
        "position": { "$ref": "#/$defs/NodePosition" },
        "actions": {
          "type": "array",
          "items": { "$ref": "#/$defs/Action" }
        }
      },
      "additionalProperties": false
    },
    "Edge": {
      "type": "object",
      "required": ["edgeId", "sequenceId", "released", "startNodeId", "endNodeId"],
      "properties": {
        "edgeId": { "type": "string" },
        "sequenceId": {
          "type": "integer",
          "minimum": 1,
          "description": "Odd integers (1, 3, 5, …)"
        },
        "released": { "type": "boolean" },
        "startNodeId": { "type": "string" },
        "endNodeId": { "type": "string" },
        "actions": {
          "type": "array",
          "items": { "$ref": "#/$defs/Action" }
        }
      },
      "additionalProperties": false
    }
  }
}
